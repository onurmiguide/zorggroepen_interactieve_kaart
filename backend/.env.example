# Kopieer dit bestand naar backend/.env en pas waarden aan.
# Het .env-bestand zelf hoort NIET in git.

# Geheime sleutel voor het signeren van sessie-JWT's. Genereer een lange random waarde.
ADMIN_JWT_SECRET=change-me-naar-een-lange-random-string

# Levensduur van een ingelogde sessie in minuten.
ADMIN_SESSION_MINUTES=480

# Toegestane frontend-origins (komma-gescheiden). Leeg = standaard localhost-lijst.
ADMIN_ALLOWED_ORIGINS=

# Pad naar het SQLite-bestand (standaard backend/data/miguide_admin.db).
ADMIN_DB_PATH=

# Cookie alleen via https versturen (zet 'true' in productie achter https).
ADMIN_COOKIE_SECURE=false

# Git-branch waar de 'Publiceren'-knop naartoe commit + pusht (standaard main).
# De live site werkt na de deploy van die branch bij.
ADMIN_PUBLISH_BRANCH=main

# Seed-admin gegevens. Worden alleen gebruikt door scripts/seed_admin.py.
SEED_ADMIN_EMAIL=admin@miguide.nl
SEED_ADMIN_NAME=MiGuide Admin
SEED_ADMIN_PASSWORD=
